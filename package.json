{
  "name": "pastillero-visual-core",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:vitest && npm run test:ui",
    "test:vitest": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:ui": "jest --config jest.config.js",
    "test:ui:watch": "jest --config jest.config.js --watch",
    "typecheck": "tsc --noEmit && npm run typecheck:ui",
    "typecheck:core": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p tests/ui/tsconfig.json",
    "seed:anmat": "tsx scripts/seed-anmat-catalog.ts",
    "verify:host": "tsx scripts/verify-host-env.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^18.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.112.4",
    "react-native-fs": "^2.20.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-tts": "^4.1.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "^0.12.1"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-native": "^0.87.0",
    "zustand": "^5.0.15"
  }
}
